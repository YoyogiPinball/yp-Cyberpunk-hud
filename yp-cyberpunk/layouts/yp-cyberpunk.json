{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "preview": "layouts/yp-cyberpunk.svg",
  "background": { "gradient": ["#241a24", "#14141c"], "angle": 165 },
  "terminal_padding": [14, 12],
  "children": [
    { "id": "topbar", "type": "block", "size": { "px": 42 }, "window_drag": true, "content": { "mod": "yp-cyberpunk-topbar" } },
    {
      "id": "work-body", "type": "row", "padding": 8, "gap": 8,
      "children": [
        {
          "id": "main", "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8, "radius": 0, "background": "background", "lone": true,
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "accent" },
              "header": { "content": { "mod": "yp-cyberpunk-pane" }, "height": 32, "position": "top", "reveal": "always" }
            }
          }
        },
        {
          "id": "panel", "type": "column", "hidden": true, "size": { "px": 368 }, "min": 280, "max": 900,
          "children": [
            {
              "id": "panel-body", "type": "stack", "active": "files",
              "children": [
                { "id": "files", "type": "block", "content": { "mod": "files" } },
                { "id": "changes", "type": "block", "content": { "mod": "changes" } }
              ]
            }
          ]
        },
        {
          "id": "side", "type": "column", "gap": 10, "size": { "px": 360 }, "min": 240, "max": 640,
          "children": [
            { "id": "job", "type": "block", "size": { "px": 160 }, "content": { "mod": "yp-cyberpunk-job" } },
            { "id": "monitor", "type": "block", "content": { "mod": "yp-cyberpunk-monitor" } },
            { "id": "machine", "type": "block", "size": { "px": 26 }, "content": { "mod": "yp-cyberpunk-machine" } }
          ]
        }
      ]
    }
  ]
}
